{
  "id": "warning_found_lodge",
  "user_turns": [
    "Hail smashed my roof last night in Brisbane 4000. I am customer CUS-12345 and I need someone out this week."
  ],
  "bom_snapshot": "QLD_hail.xml",
  "expected_tools": [
    "verify_postcode",
    "check_bom_warning",
    "lookup_policy",
    "lodge_claim",
    "schedule_assessment"
  ],
  "calls": [
    {
      "tool": "verify_postcode",
      "arguments": { "postcode": "4000" },
      "required_arguments": { "postcode": "4000" },
      "expect_result": { "valid": true, "state": "QLD", "source": "snapshot" }
    },
    {
      "tool": "check_bom_warning",
      "arguments": { "state": "QLD", "warning_types": ["hail", "severe_thunderstorm"] },
      "required_arguments": { "state": "QLD", "warning_types": ["hail", "severe_thunderstorm"] },
      "expect_result": {
        "warning_found": true,
        "warning_id": "IDQ10095-HAIL-20260926",
        "type": "hail",
        "issued_at": "2026-09-26T22:00:00+10:00",
        "source": "snapshot"
      }
    },
    {
      "tool": "lookup_policy",
      "arguments": { "customer_id": "CUS-12345" },
      "required_arguments": { "customer_id": "CUS-12345" },
      "expect_result": { "policy_id": "POL-12345", "postcode": "4000", "source": "snapshot" }
    },
    {
      "tool": "lodge_claim",
      "arguments": {
        "policy_id": "POL-12345",
        "peril": "hail",
        "address": "100 Queen Street, Brisbane QLD",
        "bom_warning_id": "$check_bom_warning.warning_id",
        "event_date": "2026-09-26"
      },
      "required_arguments": {
        "policy_id": "POL-12345",
        "peril": "hail",
        "bom_warning_id": "IDQ10095-HAIL-20260926",
        "event_date": "2026-09-26"
      },
      "expect_result": { "status": "lodged", "source": "snapshot" }
    },
    {
      "tool": "schedule_assessment",
      "arguments": {
        "claim_ref": "$lodge_claim.claim_ref",
        "preferred_window": "this_week"
      },
      "required_arguments": { "preferred_window": "this_week" },
      "expect_result": { "booking_date": "2026-10-01", "assessor_name": "Alex Nguyen", "source": "snapshot" }
    }
  ],
  "forbidden_tools": ["escalate"],
  "forbidden_strings": ["rejected", "denied", "can't lodge", "approved", "will be paid", "guaranteed"],
  "required_strings": [],
  "expected_tags": ["claim_lodged", "assessment_booked"],
  "monitoring_must_fire": []
}
